  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyIntelWhereAmdEquivalentExists1",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringLike": {
          "ec2:InstanceType": [
            "c1.*",
            "c3.*",
            "c4.*",
            "c5.*",
            "c6i.*",
            "c7i.*",
            "c8i.*",
            "m1.*",
            "m2.*",
            "m3.*",
            "m4.*",
            "m5.*",
            "m6i.*",
            "m7i.*",
            "m8i.*",
            "r3.*",
            "r4.*",
            "r5.*",
            "r6i.*",
            "r7i.*",
            "r8i.*",
            "t1.*",
            "t2.*",
            "t3.*"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": [
            "ap-northeast-1",
            "eu-west-1",
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
